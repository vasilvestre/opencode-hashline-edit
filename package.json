{
  "name": "@vasilvestre/opencode-hashline-edit",
  "version": "2.0.0",
  "description": "LINE#ID edit tool for OpenCode v2 - safe, hash-validated line-based file editing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "dev": "tsc --watch",
    "dev:plugin": "tsc -p tsconfig.plugin.json --watch",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "edit",
    "hashline",
    "line-edit"
  ],
  "author": "Valentin Silvestre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilvestre/opencode-hashline-edit"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
