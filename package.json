  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5",
    "@opencode/plugin": "^2.2.3"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
